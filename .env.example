# ============================================================
# UMER SURTI — VIP DEVELOPER PORTFOLIO
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================
# This is a static luxury portfolio that operates independently
# with client-side fallback. If integrating third-party email APIs
# or live metrics, duplicate this file as .env and populate keys.

# Optional: Formspree / EmailJS / Custom Webhook Form Endpoint
# CONTACT_FORM_ENDPOINT=https://formspree.io/f/your_form_id_here

# Optional: Public Analytics ID (Google Analytics / Plausible / Umami)
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# Optional: GitHub Personal Access Token for Dynamic API Stream
# GITHUB_API_TOKEN=your_token_placeholder_only
